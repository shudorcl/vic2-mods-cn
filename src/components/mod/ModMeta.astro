---
import type { ModEntry } from "../../utils/mods";
import { chineseLabels, formatDate, formatMonth, languageLabels } from "../../utils/mods";
import ModStatus from "./ModStatus.astro";

interface Props { mod: ModEntry; }
const { mod } = Astro.props;
---

<aside class="mod-meta" aria-label="模组信息">
  <div class="mod-meta__status"><ModStatus status={mod.data.status} /></div>
  <dl>
    <div><dt>游戏版本</dt><dd>{mod.data.gameVersion.join(" / ")}</dd></div>
    <div><dt>当前版本</dt><dd>{mod.data.latestVersion ?? "未记录"}</dd></div>
    <div><dt>最后更新</dt><dd>{formatDate(mod.data.lastUpdated)}</dd></div>
    <div><dt>开发者</dt><dd>{mod.data.authors.join("、") || "未记录"}</dd></div>
    <div><dt>语言</dt><dd>{mod.data.languages.map((lang) => languageLabels[lang] ?? lang).join("、")}</dd></div>
    <div><dt>中文支持</dt><dd>{chineseLabels[mod.data.chinese.status]}</dd></div>
  </dl>
  {mod.data.chinese.note && <p class="mod-meta__note">{mod.data.chinese.note}</p>}
  <p class="verified">资料核验：{formatMonth(mod.data.verified.date)} · {mod.data.verified.source}</p>
</aside>
