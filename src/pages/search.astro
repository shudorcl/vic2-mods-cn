---
import { Search } from "@lucide/astro";
import ContentLayout from "../layouts/ContentLayout.astro";
---

<ContentLayout title="全站搜索" eyebrow="ARCHIVE SEARCH" description="搜索模组名称、简称、简介、正文、题材与国家内容。">
  <div class="search-page">
    <div id="search" class="pagefind-container">
      <div class="search-loading"><Search size={22} /><p>正在载入本地搜索索引…</p></div>
    </div>
    <noscript>搜索功能需要启用 JavaScript。你仍可以在模组库中浏览全部条目。</noscript>
  </div>
</ContentLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js" defer></script>
<script is:inline>
  window.addEventListener("DOMContentLoaded", async () => {
    const root = document.querySelector("#search");
    try {
      if (!window.PagefindUI) throw new Error("Pagefind UI is unavailable");
      root.innerHTML = "";
      new window.PagefindUI({ element: "#search", showSubResults: true, showImages: false, translations: { placeholder: "输入关键词…", clear_search: "清除", load_more: "加载更多", search_label: "搜索本站", filters_label: "筛选", zero_results: "没有找到 [SEARCH_TERM] 的相关内容", many_results: "找到 [COUNT] 条结果", one_result: "找到 1 条结果", alt_search: "没有找到 [SEARCH_TERM]。显示 [DIFFERENT_TERM] 的结果", search_suggestion: "没有找到 [SEARCH_TERM]。可以尝试：" } });
      const query = new URLSearchParams(location.search).get("q");
      if (query) {
        const input = document.querySelector(".pagefind-ui__search-input");
        input.value = query;
        input.dispatchEvent(new Event("input", { bubbles: true }));
      }
    } catch (error) {
      root.innerHTML = '<div class="search-unavailable"><strong>开发模式下暂无搜索索引</strong><p>执行完整构建后，Pagefind 会生成可离线使用的本地索引。</p><a href="/mods/">前往模组库</a></div>';
    }
  });
</script>
